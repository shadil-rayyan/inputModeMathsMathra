<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.MCQFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Instruction -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What is the value of:"
            android:layout_margin="20dp"
            android:textColor="@color/primaryText"
            android:textSize="20sp"
            android:layout_marginVertical="8dp" />

        <!-- Question -->

        <!-- Options Grid (Flexible Rows) -->

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/question_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:contentDescription="Question: What is 2 plus 2?"
            android:importantForAccessibility="yes"
            android:text="2 + 2 = ?"
            android:textAlignment="center"
            android:textColor="@color/primaryText"
            android:textSize="32sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:rowOrderPreserved="false"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_a"
                style="@style/OptionButton"
                android:text="10"
                android:contentDescription="Option A: 10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_b"
                style="@style/OptionButton"
                android:text="20"
                android:contentDescription="Option B: 20" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_c"
                style="@style/OptionButton"
                android:text="30"
                android:contentDescription="Option C: 30" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_d"
                style="@style/OptionButton"
                android:text="40"
                android:contentDescription="Option D: 40" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_e"
                style="@style/OptionButton"
                android:text="50"
                android:contentDescription="Option E: 50" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_f"
                style="@style/OptionButton"
                android:text="60"
                android:contentDescription="Option F: 60" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_g"
                style="@style/OptionButton"
                android:text="70"
                android:contentDescription="Option G: 70" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_h"
                style="@style/OptionButton"
                android:text="80"
                android:contentDescription="Option H: 80" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_i"
                style="@style/OptionButton"
                android:text="90"
                android:contentDescription="Option I: 90" />
        </GridLayout>

        <!-- Extra Option Outside Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_j"
                style="@style/OptionButton"
                android:text="100"
                android:contentDescription="Option J: 100" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

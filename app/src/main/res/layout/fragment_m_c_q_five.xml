<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.MCQFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="150dp"
        android:padding="0dp">

        <!-- Instruction -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/instruction_text"
            android:textColor="@color/primaryText"
            android:textSize="24sp"
            android:layout_margin="10dp" />

        <!-- Question -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/question_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/math_question_text"
            android:textColor="@color/primaryText"
            android:textAlignment="center"
            android:textSize="36sp"
            android:layout_margin="10dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:contentDescription="@string/question_content_desc" />

        <!-- Option Rows (3 per row) -->
        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="100dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_a"
                style="@style/OptionButton"
                android:text="@string/option_a"
                android:contentDescription="@string/option_desc_a" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_b"
                style="@style/OptionButton"
                android:text="@string/option_b"
                android:contentDescription="@string/option_desc_b" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_c"
                style="@style/OptionButton"
                android:text="@string/option_c"
                android:contentDescription="@string/option_desc_c" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_d"
                style="@style/OptionButton"
                android:text="@string/option_d"
                android:contentDescription="@string/option_desc_d" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_e"
                style="@style/OptionButton"
                android:text="@string/option_e"
                android:contentDescription="@string/option_desc_e" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
